; pseudo-code assembler in 6502 assembly 

; data section will start at address 0x5000

; part 1, set up data section
; remember, 6502 is little endian

.org $0000
SOURCE_PTR_LOW: .byte $00 
SOURCE_PTR_HIGH: .byte $40

TGT_PTR_LOW: .byte $00
TGT_PTR_HIGH: .byte $50

OPCODE_STR_LOW: .byte $00
OPCODE_STR_HIGH: .byte $70
OPCODE_OFFSET: .byte $00
OPCODE_IDX: .byte $00

TOKEN_BUFFER_PTR: .byte $01

OPCODE_START_IDX: .byte $00

OPCODE_DIRECTORY_IDX_LOW: .byte $00
OPCODE_DIRECTORY_IDX_HIGH: .byte $20

LABEL_LIST_END_IDX_LOW: .byte $01
LABEL_LIST_END_IDX_HIGH: .byte $71


LABEL_LIST_START_IDX_LOW: .byte $01
LABEL_LIST_START_IDX_HIGH: .byte $71

SECOND_PASS: .byte $00

DIRECTIVE_IDX: .byte $00

DIRECTIVE_PTR_LOW: .byte $01
DIRECTIVE_PTR_HIGH: .byte $65

; source token buffer $1000 opcode, $1100 operand
.org $1000

; scratch space
.org $1200

; temp memory
.org $1500

; opcode directory
.org $2000

; 0 - Implied
; 1 - Immediate
; 2 - Zero Page
; 3 - Zero Page, X
; 4 - Zero Page, Y
; 5 - Absolute
; 6 - Absolute, X
; 7 - Absolute, Y
; 8 - Indrect, X
; 9 - Indirect, Y
; 10 - Accumulator
; 11 - Relative
; 12 - Absolute Indirect


; 13 * 56 = 728
; $2000 - $21FF~ , opcode directory
; $02 illegal placeholder, add $0D to get to next opcode

;opcode index 0

ADC:
.byte $02 ; implied
.byte $69 ; immediate
.byte $65 ; zero page
.byte $75 ; zero page, X
.byte $02 ; zero page, Y
.byte $6D ; absolute
.byte $7D ; absolute, X
.byte $79 ; absolute, Y
.byte $61 ; indirect, x
.byte $71 ; indirect, y
.byte $02 ; accumulator
.byte $02 ; relative
.byte $02 ; absolute indirect

;opcode index 1
AND:
.byte $02 ; implied
.byte $29 ; immediate
.byte $25 ; zero page
.byte $35 ; zero page, X
.byte $02 ; zero page, Y
.byte $2D ; absolute
.byte $3D ; absolute, X
.byte $39 ; absolute, Y
.byte $21 ; indirect, x
.byte $31 ; indirect, y
.byte $02 ; accumulator
.byte $02 ; relative
.byte $02 ; absolute indirect

; $5000 output machine code program

; directive strings 6500-6999, first byte is total directives, then length of directive followed by characters.
.org $6500
DIRECTIVES_STR: .byte $01 .byte $03 .byte $45 .byte $4E .byte $44

;opcode strings 7000 - 7099
.org $7000   ; 'L'          'D'       'A'
OPCODES_STR: .byte $4C .byte $44 .byte $41  ; ... etc

;dynamic label space 7100 - 7999
.org $7100


;part 2 program section

.org $8000

MAIN:

JSR RESET_OPCODE_IDX

JSR SKIP_SPACES_COMMENTS

PARSE_TOKEN:

LDY #$00
LDA ($00),Y

CMP #$20 ; we could have a space '$20' or newline
BEQ PARSE_OPCODE_ENTRY_LABEL_TOKEN

CMP #$0A
BEQ PARSE_OPCODE_ENTRY_LABEL_TOKEN

CMP #$2E
BEQ HANDLE_DIRECTIVES

PHA

JSR INCREMENT_SOURCE_PTR

PLA

; read string buffer length
LDX $1000
STA $1001,X
INC $1000

JMP PARSE_TOKEN


SKIP_SPACES_COMMENTS:
;at this point we know we are on a fresh 'line', 
LDY #$00
LDA ($00),Y

CMP #$20 ; space case
BEQ SKIP_BYTE

CMP #$0A ; skip newline
BEQ SKIP_BYTE

CMP #$3B ; semi colon
BEQ SKIP_COMMENT

RTS


SKIP_BYTE:
JSR INCREMENT_SOURCE_PTR
JMP SKIP_SPACES_COMMENTS

SKIP_COMMENT:
JSR INCREMENT_SOURCE_PTR
LDY #$00
LDA ($00),Y
CMP #0A
BEQ SKIP_SPACES_COMMENTS
JMP SKIP_COMMENT


INCREMENT_SOURCE_PTR:
LDA $0000
CLC
ADC #$01
STA $0000
LDA $0001
ADC #$00
STA $0001
RTS


INCREMENT_TGT_PTR:
LDA $0002
CLC
ADC #$01
STA $0002
LDA $0003
ADC #$00
STA $0003
RTS

INCREMENT_LABEL_PTR:
LDA $000C
CLC
ADC #$01
STA $000C
LDA $000D
ADC #$00
STA $000D
RTS

INCREMENT_LABEL_START_PTR:
LDA $000E
CLC
ADC #$01
STA $000E
LDA $000F
ADC #$00
STA $000F
RTS

PARSE_OPCODE_ENTRY_LABEL_TOKEN:

; check if label
LDX $1000 ; token string length
LDA $1000,X

CMP #$3A ; ends with a colon
BEQ CREATE_LABEL

LDA $1000
CMP #$03
BNE ERROR_OP_CODE_NOT_FOUND

LDY #$00
MATCH_LOOP:

LDX $0006;
LDA $7000,X

LDX $0008
CMP $1000,X
BNE SET_NEXT_OPCODE

INC $0008
INC $0006
INY
CPY #$03
BNE MATCH_LOOP
JMP FINALIZE_OPCODE


SET_NEXT_OPCODE:
;0 - 55 legal
INC $0007 ; op code index
LDA $0007
CMP #$56
BEQ ERROR_OP_CODE_NOT_FOUND

LDA $0009;
CLC
ADC #$03;
STA $0009
STA $0006
LDA #$01
STA $0008

LDA $000A
CLC
ADC #$0D
STA $000A
LDA $000B
ADC #$00
STA $000B
CLC

LDY #$00
JMP MATCH_LOOP


FINALIZE_OPCODE:

LDY #$00
LDA ($0A),Y

CMP #$02 ; implied mode?

BEQ FINALIZE_OPCODE_CONTINUED

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

JMP MAIN


FINALIZE_OPCODE_CONTINUED:
; read in next token and parse the operand
; cases, 
; 1 - first character is '#', must be immediate 
; 2 - first character is '$', can be absolute or absolute X, or zp depending on length
; 3 - first character is 'A', accumulator
; 4 - first character is '(', indirect x or y) , must be length of 7
; 5 - relative branch ; check label storage, careful because might only know on second pass

JSR SKIP_SPACES_COMMENTS

LDA #$00
STA $1100

JSR PARSE_OPERAND

LDA $1101

CMP #$23 ; #
BEQ HANDLE_IMMEDIATE

CMP #$24 ; $
BEQ HANDLE_ABSOLUTE

CMP #$65 ; A
BEQ HANDLE_ACCUMULATOR

CMP #$28 ; (
BEQ HANDLE_INDIRECT


JSR HANDLE_LABEL_OPERAND


JMP MAIN


PARSE_OPERAND:

LDY #$00
LDA ($00),Y

CMP #$20 ; we could have a space '$20' or newline
BEQ RETURN

CMP #$0A
BEQ RETURN

PHA

JSR INCREMENT_SOURCE_PTR

PLA

; read string buffer length
LDX $1100
STA $1101,X
INC $1100

JMP PARSE_OPERAND

RETURN:
RTS


HANDLE_IMMEDIATE:
; first check, is the immedate opcode not $02

LDY #$01
LDA ($0A),Y

CMP #$02
BEQ ERROR_ADDRESS_MODE_NOT_SUPPORTED

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

LDA $1102
CMP #$24
BNE ERROR_EXPECTED_DOLLAR_SIGN

LDA $1103 ; hex upper nibble, utf8

JSR CONVERT_HEX

JSR FORM_HIGH_NIBBLE

STA $1200;

LDA $1104 
JSR CONVERT_HEX
ORA $1200;

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

JMP MAIN


HANDLE_ABSOLUTE:

LDA #$07
CMP $1100
BCS HANDLE_ABSOLUTE_XY

LDY #$05
LDA ($0A),Y

CMP #$02
BEQ ERROR_ADDRESS_MODE_NOT_SUPPORTED

HANDLE_ABSOLUTE_CONTINUED:

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

LDA $1101
CMP #$24
BNE ERROR_EXPECTED_DOLLAR_SIGN

LDA $1102 ; hex upper nibble, utf8

JSR CONVERT_HEX

JSR FORM_HIGH_NIBBLE

STA $1200;

LDA $1103 
JSR CONVERT_HEX
ORA $1200;

STA $1201; high byte

LDA $1104
JSR CONVERT_HEX
JSR FORM_HIGH_NIBBLE

STA $1200

LDA $1105
JSR CONVERT_HEX
ORA $1200;

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

LDA $1201

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

JMP MAIN


HANDLE_ABSOLUTE_XY:
LDX $1100
LDA $1100,X
CMP #$58 ; X
BEQ HANDLE_ABSOLUTE_X

LDX $1100
LDA $1100,X
CMP #$59 ; Y
BEQ HANDLE_ABSOLUTE_Y

HANDLE_ABSOLUTE_X:
LDY #$06
LDA ($0A),Y

CMP #$02
BEQ ERROR_ADDRESS_MODE_NOT_SUPPORTED

JMP HANDLE_ABSOLUTE_CONTINUED

HANDLE_ABSOLUTE_Y:
LDY #$07
LDA ($0A),Y

CMP #$02
BEQ ERROR_ADDRESS_MODE_NOT_SUPPORTED

JMP HANDLE_ABSOLUTE_CONTINUED


HANDLE_ACCUMULATOR:
; first check, is the accumulator opcode $0A not $02

LDY #$0A
LDA ($0A),Y

CMP #$02
BEQ ERROR_ADDRESS_MODE_NOT_SUPPORTED

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

JMP MAIN

HANDLE_INDIRECT:
; for now, just support indirect Y

LDY #$09
LDA ($0A),Y

CMP #$02
BEQ ERROR_ADDRESS_MODE_NOT_SUPPORTED

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

LDA $1101
CMP #$24
BNE ERROR_EXPECTED_DOLLAR_SIGN

LDA $1102
CMP #$24
BNE ERROR_EXPECTED_DOLLAR_SIGN

; its possible we have a label here too
; so if its not a dollar sign check all characters up to ')'

LDA $1103 ; hex upper nibble, utf8

JSR CONVERT_HEX

JSR FORM_HIGH_NIBBLE

STA $1200;

LDA $1104 
JSR CONVERT_HEX
ORA $1200;

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR


JMP MAIN



HANDLE_ABSOLUTE_LABEL:

LDY #$05
LDA ($0A),Y

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

LDA $1705
STA ($02),Y

JSR INCREMENT_TGT_PTR

LDA $1706
STA ($02),Y

JSR INCREMENT_TGT_PTR

JMP MAIN



HANDLE_BRANCH_RELATIVE:

LDY #$0B
LDA ($0A),Y

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

; get the low byte of the label
; find 
; 

; target $1705 - source $0002 + 2

LDA $1705

SEC
SBC $0002
CLC
ADC #$02

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

JMP MAIN


SET_LABEL_PLACEHOLDERS:

LDY #$0B
LDA ($0A),Y

CMP #$02
BEQ SET_ABSOLUTE_PLACEHOLDERS

LDY #$0B
LDA ($0A),Y

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

LDA #$00

STA ($02),Y

JSR INCREMENT_TGT_PTR

JMP MAIN


SET_ABSOLUTE_PLACEHOLDERS:

LDY #$05
LDA ($0A),Y

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

LDA #$00

STA ($02),Y

JSR INCREMENT_TGT_PTR

STA ($02),Y

JSR INCREMENT_TGT_PTR

JMP MAIN




HANDLE_LABEL_OPERAND:
;handle label Operand
; we either have a branch relative, or absolute address
; if we are on first pass and can't find the label, put a placeholder, else error

;clear scratch space
LDA #$00
STA $1700
STA $1701
STA $1702
STA $1703
STA $1704
STA $1705
STA $1706

;reset label storage pointer
LDA #$01
STA $000E
LDA #$71
STA $000F

; handle ',X' case later

JSR FIND_LABEL

; if a label was found, $1704 should be set to 1, $1705, $1706 hold the target address

LDA $1704
CMP #$01
BEQ HANDLE_LABEL_OPERAND_CONTINUED

LDA $0010
CMP #$00
BEQ SET_PLACEHOLDERS

; error label not found
;set error code, go into break state


HANDLE_LABEL_OPERAND_CONTINUED:

; check to see if we are dealing with a branch operation
; branch operation will have the relative mode not set to #$02
; $0B

LDY #$0B
LDA ($0A),Y

CMP #$02
BEQ HANDLE_ABSOLUTE_LABEL

JMP HANDLE_BRANCH_RELATIVE



FIND_LABEL:

; label operand currently at $1100
; label storage at $7100
; use $1700 for scratch space
; $1700 label storage, label length


LDA $7100
CMP #$00
BEQ RETURN

LDX #$00
FIND_LABEL_LOOP:

INX

; store label length
LDY #$00
LDA ($0E),Y
STA $1700

LDA $1100

CMP $1700
BEQ CHECK_LABEL_CHARACTERS

CPX $7100
BNE SET_NEXT_LABEL

; if we hit here we have gone through all labels
; label not found

LDA #$00
STA $1704

RETURN



SET_NEXT_LABEL:

LDY #$0
CHECK_NEXT_LABEL_LOOP:

INY

JSR INCREMENT_LABEL_START_PTR

CPY $1700
BNE CHECK_NEXT_LABEL_LOOP

JSR INCREMENT_LABEL_START_PTR
JSR INCREMENT_LABEL_START_PTR
JSR INCREMENT_LABEL_START_PTR

JMP FIND_LABEL_LOOP


CHECK_LABEL_CHARACTERS:
; x, a, b, c, t0, t1, y
; ^,                , *

LDY #$00

MATCH_LABEL_LOOP:

CPY $1700
BEQ LABEL_FOUND

INY

LDA $1100,Y
CMP ($0E),Y
BEQ MATCH_LABEL_LOOP

JMP SET_NEXT_LABEL


LABEL_FOUND:
; copy the target memory location to a scratch space
; then return back to 'handle label'

LDA #$01
STA $1704

LDY $1700
INY
LDA ($0E),Y
STA $1705
INY
LDA ($0E),Y
STA $1706

RETURN





CREATE_LABEL:

; increment list length by one
INC $7100


LDA $1000 ; label length
; need to subtract 1 because of the colon
SEC
SBC #$01

; $0C holds the end of the label list
LDY #$00

; 1 - store label length
STA ($0C),Y

; increment label list pointer
JSR INCREMENT_LABEL_PTR


; 2 - store label characters

LDX #$01
LOOP:
LDA $1000,X
LDY #$00
STA ($0C),Y
JSR INCREMENT_LABEL_PTR
INX
CPX $1000
BNE LOOP

; 3 - store the target pointer

LDA $0002
LDY #$00
STA ($0C),Y
JSR INCREMENT_LABEL_PTR
LDA $0003
LDY #$00
STA ($0C),Y
JSR INCREMENT_LABEL_PTR

JMP MAIN


; the other case of label usage is a label reference in the operand
; its possible we don't know how to decode the label until the second pass
; in that case we put a placeholder
; if label still doesn't exist on the second pass, set an error code
DECODE_BRANCH_LABEL:


DECODE_OPERAND_LABEL:

RESET_OPCODE_IDX:
LDA #$00
STA $0007
STA $0009
STA $0006
STA $000A
LDA #$20
STA $000B
RTS

ERROR_OP_CODE_NOT_FOUND:
LDA #$05 ; use #$05 to represent op code not found error
STA $1500
BRK

ERROR_EXPECTED_DOLLAR_SIGN:
LDA #$06
STA $1500
BRK

ERROR_ADDRESS_MODE_NOT_SUPPORTED:
LDA #$07
STA $1500
BRK


CONVERT_HEX:
; 0 - 9, is $30 - $39 in hex utf8
; check if value is greater than $39, if so we subtract $37 not $30
CMP #$40
BCS CONVERT_HEX_LETTER

SEC
SBC #$30
RTS

CONVERT_HEX_LETTER:
SEC
SBC #$37
RTS

FORM_HIGH_NIBBLE:
ASL A
ASL A
ASL A
ASL A
RTS

HANDLE_DIRECTIVES:
; need to continue reading characters until space or newline

JSR INCREMENT_SOURCE_PTR

LDA #$00
STA $1000

PARSE_DIRECTIVE:

LDY #$00
LDA ($00),Y

CMP #$20 ; we could have a space '$20' or newline
BEQ FIND_DIRECTIVE

CMP #$0A
BEQ FIND_DIRECTIVE

PHA

JSR INCREMENT_SOURCE_PTR

PLA

; read string buffer length
LDX $1000
STA $1001,X
INC $1000

JMP PARSE_DIRECTIVE


FIND_DIRECTIVE:



LDX #$00
LOOP_DIRECTIVES:

CMP $6500
BEQ DIRECTIVE_NOT_FOUND

JSR CHECK_NEXT_DIRECTIVE

INX
JMP LOOP_DIRECTIVES


CHECK_NEXT_DIRECTIVE:

; compare characters in $1000, to characters in $6500
; $12, $13 hold the directive pointer
; so we just need an offset


LDA $1000

LDY #$00
CMP (#12),Y
BNE RETURN

LDY #$00
LDX #$00

CHECK_DIRECTIVE:
; if X equals length, we have found it
LDX $1501
LDA $1501
CMP $1000
BEQ DIRECTIVE_FOUND

INX
INY

LDA $1000,X
CPY ($12),Y
BEQ CHECK_DIRECTIVE

RETURN











