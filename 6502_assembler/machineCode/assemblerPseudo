; pseudo-code assembler in 6502 assembly 

; data section will start at address 0x5000

; part 1, set up data section
; remember, 6502 is little endian

.org $0000
SOURCE_PTR_LOW: .byte $00 
SOURCE_PTR_HIGH: .byte $40

TGT_PTR_LOW: .byte $00
TGT_PTR_HIGH: .byte $50

OPCODE_STR_LOW: .byte $00
OPCODE_STR_HIGH: .byte $70
OPCODE_OFFSET: .byte $00
OPCODE_IDX: .byte $00

TOKEN_BUFFER_PTR: .byte $01

OPCODE_START_IDX: .byte $00

OPCODE_DIRECTORY_IDX_LOW: .byte $00
OPCODE_DIRECTORY_IDX_HIGH: .byte $20

LABEL_LIST_END_IDX_LOW: .byte $01
LABEL_LIST_END_IDX_HIGH: .byte $71

; source token buffer $1000 opcode, $1100 operand
.org $1000

; scratch space
.org $1200

; temp memory
.org $1500

; opcode directory
.org $2000

; 0 - Implied
; 1 - Immediate
; 2 - Zero Page
; 3 - Zero Page, X
; 4 - Zero Page, Y
; 5 - Absolute
; 6 - Absolute, X
; 7 - Absolute, Y
; 8 - Indrect, X
; 9 - Indirect, Y
; 10 - Accumulator
; 11 - Relative
; 12 - Absolute Indirect


; 13 * 56 = 728
; $2000 - $21FF~ , opcode directory
; $02 illegal placeholder, add $0D to get to next opcode

;opcode index 0

ADC:
.byte $02 ; implied
.byte $69 ; immediate
.byte $65 ; zero page
.byte $75 ; zero page, X
.byte $02 ; zero page, Y
.byte $6D ; absolute
.byte $7D ; absolute, X
.byte $79 ; absolute, Y
.byte $61 ; indirect, x
.byte $71 ; indirect, y
.byte $02 ; accumulator
.byte $02 ; relative
.byte $02 ; absolute indirect

;opcode index 1
AND:
.byte $02 ; implied
.byte $29 ; immediate
.byte $25 ; zero page
.byte $35 ; zero page, X
.byte $02 ; zero page, Y
.byte $2D ; absolute
.byte $3D ; absolute, X
.byte $39 ; absolute, Y
.byte $21 ; indirect, x
.byte $31 ; indirect, y
.byte $02 ; accumulator
.byte $02 ; relative
.byte $02 ; absolute indirect

; $5000 output machine code program

;opcode strings 7000 - 7099
.org $7000   ; 'L'          'D'       'A'
OPCODES_STR: .byte $4C .byte $44 .byte $41  ; ... etc

;dynamic label space 7100 - 7999
.org $7100


;part 2 program section

.org $8000

MAIN:

JSR RESET_OPCODE_IDX

JSR SKIP_SPACES_COMMENTS

PARSE_TOKEN:

LDY #$00
LDA ($00),Y

CMP #$20 ; we could have a space '$20' or newline
BEQ PARSE_OPCODE_ENTRY_LABEL_TOKEN

CMP #$0A
BEQ PARSE_OPCODE_ENTRY_LABEL_TOKEN

PHA

JSR INCREMENT_SOURCE_PTR

PLA

; read string buffer length
LDX $1000
STA $1001,X
INC $1000

JMP PARSE_TOKEN


SKIP_SPACES_COMMENTS:
;at this point we know we are on a fresh 'line', 
LDY #$00
LDA ($00),Y

CMP #$20 ; space case
BEQ SKIP_BYTE

CMP #$0A ; skip newline
BEQ SKIP_BYTE

CMP #$3B ; semi colon
BEQ SKIP_COMMENT

RTS


SKIP_BYTE:
JSR INCREMENT_SOURCE_PTR
JMP SKIP_SPACES_COMMENTS

SKIP_COMMENT:
JSR INCREMENT_SOURCE_PTR
LDY #$00
LDA ($00),Y
CMP #0A
BEQ SKIP_SPACES_COMMENTS
JMP SKIP_COMMENT


INCREMENT_SOURCE_PTR:
LDA $0000
CLC
ADC #$01
STA $0000
LDA $0001
ADC #$00
STA $0001
RTS


INCREMENT_TGT_PTR:
LDA $0002
CLC
ADC #$01
STA $0002
LDA $0003
ADC #$00
STA $0003
RTS

INCREMENT_LABEL_PTR:
LDA $000C
CLC
ADC #$01
STA $000C
LDA $000D
ADC #$00
STA $000D
RTS

PARSE_OPCODE_ENTRY_LABEL_TOKEN:

; check if label
LDX $1000 ; token string length
LDA $1000,X

CMP #$3A ; ends with a colon
BEQ CREATE_LABEL

LDA $1000
CMP #$03
BNE ERROR_OP_CODE_NOT_FOUND

LDY #$00
MATCH_LOOP:

LDX $0006;
LDA $7000,X

LDX $0008
CMP $1000,X
BNE SET_NEXT_OPCODE

INC $0008
INC $0006
INY
CPY #$03
BNE MATCH_LOOP
JMP FINALIZE_OPCODE


SET_NEXT_OPCODE:
;0 - 55 legal
INC $0007 ; op code index
LDA $0007
CMP #$56
BEQ ERROR_OP_CODE_NOT_FOUND

LDA $0009;
CLC
ADC #$03;
STA $0009
STA $0006
LDA #$01
STA $0008

LDA $000A
CLC
ADC #$0D
STA $000A
LDA $000B
ADC #$00
STA $000B
CLC

LDY #$00
JMP MATCH_LOOP


FINALIZE_OPCODE:

LDY #$00
LDA ($0A),Y

CMP #$02 ; implied mode?

BEQ FINALIZE_OPCODE_CONTINUED

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

JMP MAIN


FINALIZE_OPCODE_CONTINUED:
; read in next token and parse the operand
; cases, 
; 1 - first character is '#', must be immediate 
; 2 - first character is '$', can be absolute or absolute X, or zp depending on length
; 3 - first character is 'A', accumulator
; 4 - first character is '(', indirect x or y) , must be length of 7
; 5 - relative branch ; check label storage, careful because might only know on second pass

JSR SKIP_SPACES_COMMENTS

LDA #$00
STA $1100

JSR PARSE_OPERAND

LDA $1101

CMP #$23 ; #
BEQ HANDLE_IMMEDIATE

CMP #$24 ; $
BEQ HANDLE_ABSOLUTE

CMP #$65 ; A
BEQ HANDLE_ACCUMULATOR

CMP #$28 ; (
BEQ HANDLE_INDIRECT

;handle branch
;only branches have relative mode not $02

JMP MAIN


PARSE_OPERAND:

LDY #$00
LDA ($00),Y

CMP #$20 ; we could have a space '$20' or newline
BEQ RETURN

CMP #$0A
BEQ RETURN

PHA

JSR INCREMENT_SOURCE_PTR

PLA

; read string buffer length
LDX $1100
STA $1101,X
INC $1100

JMP PARSE_OPERAND

RETURN:
RTS


HANDLE_IMMEDIATE:
; first check, is the immedate opcode not $02

LDY #$01
LDA ($0A),Y

CMP #$02
BEQ ERROR_ADDRESS_MODE_NOT_SUPPORTED

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

LDA $1102
CMP #$24
BNE ERROR_EXPECTED_DOLLAR_SIGN

LDA $1103 ; hex upper nibble, utf8

JSR CONVERT_HEX

JSR FORM_HIGH_NIBBLE

STA $1200;

LDA $1104 
JSR CONVERT_HEX
ORA $1200;

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

JMP MAIN


HANDLE_ABSOLUTE:

LDA #$06
CMP $1100
BCS HANDLE_ABSOLUTE_XY

LDY #$05
LDA ($0A),Y

CMP #$02
BEQ ERROR_ADDRESS_MODE_NOT_SUPPORTED

HANDLE_ABSOLUTE_CONTINUED:

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

LDA $1101
CMP #$24
BNE ERROR_EXPECTED_DOLLAR_SIGN

LDA $1102 ; hex upper nibble, utf8

JSR CONVERT_HEX

JSR FORM_HIGH_NIBBLE

STA $1200;

LDA $1103 
JSR CONVERT_HEX
ORA $1200;

STA $1201; high byte

LDA $1104
JSR CONVERT_HEX
JSR FORM_HIGH_NIBBLE

STA $1200

LDA $1105
JSR CONVERT_HEX
ORA $1200;

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

LDA $1201

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

JMP MAIN


HANDLE_ABSOLUTE_XY:
LDX $1100
LDA $1100,X
CMP #$58 ; X
BEQ HANDLE_ABSOLUTE_X

LDX $1100
LDA $1100,X
CMP #$59 ; Y
BEQ HANDLE_ABSOLUTE_Y

HANDLE_ABSOLUTE_X:
LDY #$06
LDA ($0A),Y

CMP #$02
BEQ ERROR_ADDRESS_MODE_NOT_SUPPORTED

JMP HANDLE_ABSOLUTE_CONTINUED

HANDLE_ABSOLUTE_Y:
LDY #$07
LDA ($0A),Y

CMP #$02
BEQ ERROR_ADDRESS_MODE_NOT_SUPPORTED

JMP HANDLE_ABSOLUTE_CONTINUED


HANDLE_ACCUMULATOR:
; first check, is the accumulator opcode $0A not $02

LDY #$0A
LDA ($0A),Y

CMP #$02
BEQ ERROR_ADDRESS_MODE_NOT_SUPPORTED

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

JMP MAIN

HANDLE_INDIRECT:
; for now, just support indirect Y

LDY #$09
LDA ($0A),Y

CMP #$02
BEQ ERROR_ADDRESS_MODE_NOT_SUPPORTED

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR

LDA $1101
CMP #$24
BNE ERROR_EXPECTED_DOLLAR_SIGN

LDA $1102
CMP #$24
BNE ERROR_EXPECTED_DOLLAR_SIGN

; its possible we have a label here too
; so if its not a dollar sign check all characters up to ')'

LDA $1103 ; hex upper nibble, utf8

JSR CONVERT_HEX

JSR FORM_HIGH_NIBBLE

STA $1200;

LDA $1104 
JSR CONVERT_HEX
ORA $1200;

LDY #$00
STA ($02),Y

JSR INCREMENT_TGT_PTR


JMP MAIN


CREATE_LABEL:
; this is the case of a Label creation
; create the label entry record
; jump back to main, output pointer not changed
; label storage starts at $7100, initally zeroed out
; we need to create a list strucutre
; first byte will be the length of the list, (should start at zero)
; next byte will be the length of the label string
; next x bytes will be the label string characters
; finally last 2 bytes will be the memory location
; this will simply be a copy of the target pointer

;first, read length of the list into memory,
;using the length, traverse to the end of the list in a loop
; once we have the pointer to the end of the list, we can dump the data
; then increment the label list length

; read length

; increment list length by one

INC $7000

LDA $1000 ; label length
; need to subtract 1 because of the colon
SEC
SBC #$01

; $0C holds the end of the label list
LDY #$0C
STA ($00),Y

; increment label list pointer
JSR INCREMENT_LABEL_PTR

LDA $1000
SEC
SBC #$01
STA $1600

LDA #$01
STA $1601
LDA #$10
STA $1602
LDA $1001

LDY #$0C
LDX #$00

LOOP:
STA ($00),Y
JSR INCREMENT_LABEL_PTR
INX
CMX $1600
BNE LOOP

STA 
LDY 



; the other case of label usage is a label reference in the operand
; its possible we don't know how to decode the label until the second pass
; in that case we put a placeholder
; if label still doesn't exist on the second pass, set an error code
DECODE_BRANCH_LABEL:


DECODE_OPERAND_LABEL:

RESET_OPCODE_IDX:
LDA #$00
STA $0007
STA $0009
STA $0006
STA $000A
LDA #$20
STA $000B
RTS

ERROR_OP_CODE_NOT_FOUND:
LDA #$05 ; use #$05 to represent op code not found error
STA $1500
BRK

ERROR_EXPECTED_DOLLAR_SIGN:
LDA #$06
STA $1500
BRK

ERROR_ADDRESS_MODE_NOT_SUPPORTED:
LDA #$07
STA $1500
BRK


CONVERT_HEX:
; 0 - 9, is $30 - $39 in hex utf8
; check if value is greater than $39, if so we subtract $37 not $30
CMP #$40
BCS CONVERT_HEX_LETTER

SEC
SBC #$30
RTS

CONVERT_HEX_LETTER:
SEC
SBC #$37
RTS

FORM_HIGH_NIBBLE:
ASL A
ASL A
ASL A
ASL A
RTS















